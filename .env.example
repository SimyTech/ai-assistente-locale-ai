# MAVIRI — Core SaaS (required)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAVIRI_SESSION_SECRET=

# Automatic appointment reminders (required to authorize /api/reminders)
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional alternative when reminders are triggered by another scheduler.
MAVIRI_REMINDER_SECRET=

# Account recovery email (required for password reset delivery)
RESEND_API_KEY=
MAVIRI_EMAIL_FROM=
MAVIRI_PUBLIC_URL=https://ai-assistente-locale-ai.vercel.app

# Optional migration / legacy accounts
MAVIRI_OWNER_ACCOUNTS={}
MAVIRI_OWNER_SYNC_TOKEN=
MAVIRI_OWNER_TOKENS={}
MAVIRI_DEFAULT_TENANT=default

# WhatsApp Cloud API (optional until connected)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
MAVIRI_WHATSAPP_TENANTS={}
