{
  "rewrites": [
    { "source": "/", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/verify-email", "destination": "/verify-email.html" },
    { "source": "/api/chat", "destination": "/api/chat-entry" },
    { "source": "/api/whatsapp", "destination": "/api/whatsapp-proxy" },
    { "source": "/api/readiness", "destination": "/api/health?mode=readiness" },
    { "source": "/api/reminders", "destination": "/api/health?mode=reminders" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/login", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/register", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/setup", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/account", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/forgot-password", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/reset-password", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/verify-email", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
